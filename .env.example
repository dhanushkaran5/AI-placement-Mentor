# AI Placement Mentor - Root Environment Configuration Template

# Backend Configuration (backend/.env)
PORT=5000
JWT_SECRET=your_secure_random_jwt_secret_here_change_in_production
FRONTEND_URL=https://your-frontend.onrender.com

# Optional Anthropic Claude API Key for Live LLM Mode
# If omitted or left blank, the application automatically runs in High-Performance Local Heuristics Fallback Mode
ANTHROPIC_API_KEY=

# Frontend Configuration (frontend/.env)
VITE_API_URL=http://localhost:5000/api
# For Render Production Frontend:
# VITE_API_URL=https://your-backend.onrender.com/api
